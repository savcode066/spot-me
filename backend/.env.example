TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Production example: ALLOWED_ORIGINS=https://your-app.vercel.app
# Multiple: ALLOWED_ORIGINS=https://your-app.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# Required for POST /api/chess/youtube/search only.
# No credentials needed for /api/chess/kick/search (unauthenticated).
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Optional — chess matchup search tuning, sensible defaults if unset
VOD_CACHE_TTL_SECONDS=1800      # how long a streamer's VOD list stays cached
YOUTUBE_QUOTA_DAILY_LIMIT=10000 # YouTube Data API v3 daily budget
