TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Production example: ALLOWED_ORIGINS=https://your-app.vercel.app
# Multiple: ALLOWED_ORIGINS=https://your-app.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# Required for POST /api/chess/youtube/search only.
# No credentials needed for /api/chess/kick/search (unauthenticated).
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Required for POST /api/valorant/search, /api/valorant/kick/search, and
# /api/valorant/youtube/search. Get a key from https://docs.henrikdev.xyz/
VALORANT_API_KEY=your_henrikdev_api_key_here

# No credentials needed for POST /api/dota2/search, /api/dota2/kick/search,
# or /api/dota2/youtube/search — match data comes from OpenDota's public,
# unauthenticated API (https://docs.opendota.com/).

# Optional — chess matchup search tuning, sensible defaults if unset
VOD_CACHE_TTL_SECONDS=1800      # how long a streamer's VOD list stays cached
YOUTUBE_QUOTA_DAILY_LIMIT=10000 # YouTube Data API v3 daily budget

# Optional — enables Redis-backed rate limiting, VOD cache, YouTube quota
# counter, and upstream-API throttling, all shared correctly across every
# backend instance/worker. Required for correctness once more than one
# instance or uvicorn worker is running at once (e.g. Cloud Run under load);
# falls back to in-process behavior (correct for a single instance only) if
# unset, so local dev works fine without it.
REDIS_URL=rediss://default:password@host:port

# Uvicorn worker-process count per container instance (see Dockerfile).
WEB_CONCURRENCY=2
